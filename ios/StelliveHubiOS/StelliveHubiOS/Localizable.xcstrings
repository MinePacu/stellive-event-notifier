    "reservation_error_draft_missing" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱에서 티켓·구매·예약 링크를 먼저 열어 주세요." } } } },
    "reservation_error_duplicate_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 내역에 같은 상세 링크가 연결되어 있습니다." } } } },
    "reservation_error_duplicate_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 링크가 이미 있습니다" } } } },
    "reservation_error_end_time" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "종료 시각은 시작 시각보다 뒤여야 합니다." } } } },
    "reservation_error_invalid_url" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트가 있는 HTTPS 링크를 입력해 주세요." } } } },
    "reservation_error_paste_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드에서 유효한 HTTPS 링크를 찾지 못했습니다. 링크를 다시 복사해 붙여넣거나 링크 없이 추가할 수 있습니다." } } } },
