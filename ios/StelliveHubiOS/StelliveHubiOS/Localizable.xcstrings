    "reservation_error_quantity" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "수량은 1 이상으로 입력해 주세요." } } } },
    "reservation_error_recording_failed" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "외부 링크는 열었지만 확인 필요 항목을 저장하지 못했습니다." } } } },
    "reservation_error_select_draft" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "추가할 내역을 선택해 주세요." } } } },
    "reservation_error_sensitive_explanation" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보가 포함된 링크일 수 있습니다. 이 기기에만 저장하며 백업 대상에서는 제외합니다." } } } },
    "reservation_error_sensitive_url" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보가 포함될 수 있는 링크입니다. 저장 여부를 확인해 주세요." } } } },
    "reservation_error_storage_unavailable" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내역 저장 공간을 열 수 없습니다." } } } },
    "reservation_help_delete_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱에서 내역을 삭제해도 외부 서비스의 실제 예매·주문·예약은 취소되지 않습니다." } } } },
    "reservation_help_delete_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내역 삭제는 외부 취소가 아닙니다" } } } },
    "reservation_help_detail_actions_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장한 내역을 확인하고 필요한 정보를 직접 관리할 수 있습니다." } } } },
    "reservation_help_detail_actions_edit" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "상태·일정·장소를 수정할 수 있습니다." } } } },
    "reservation_help_detail_actions_link" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내역 링크를 열어 외부 서비스의 상세 페이지를 확인할 수 있습니다." } } } },
    "reservation_help_detail_actions_notes" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "옵션·수량·예매/주문/예약번호·메모를 기록할 수 있습니다." } } } },
    "reservation_help_detail_actions_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 화면에서 할 수 있는 일" } } } },
    "reservation_help_detail_summary" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 화면에서 저장한 정보를 확인하고 수정하거나 내역 링크를 열 수 있습니다." } } } },
    "reservation_help_detail_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내역 상세 도움말" } } } },
    "reservation_help_faq_cancelled_answer" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 행사 정보가 변경되거나 취소되어도 사용자의 내역 상태와 직접 수정한 값은 자동으로 바뀌지 않습니다." } } } },
    "reservation_help_faq_cancelled_question" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결된 행사가 변경되거나 취소되면 어떻게 되나요?" } } } },
    "reservation_help_faq_collapse_hint" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "답변 접기" } } } },
    "reservation_help_faq_duplicate_answer" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "기존 내역을 먼저 확인하거나, 서로 다른 항목이 맞다면 그래도 저장할 수 있습니다." } } } },
    "reservation_help_faq_duplicate_question" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 링크가 이미 있다고 나오나요?" } } } },
    "reservation_help_faq_expand_hint" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "답변 펼치기" } } } },
    "reservation_help_faq_header" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "문제가 있나요?" } } } },
    "reservation_help_faq_link_answer" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "상세 링크를 찾지 못해도 확인 필요 항목에서 링크 없이 추가할 수 있습니다." } } } },
    "reservation_help_faq_link_question" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "상세 링크를 찾지 못했나요?" } } } },
    "reservation_help_faq_return_answer" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 예약·구매의 확인 필요에서 임시 항목을 직접 선택해 추가할 수 있습니다. 외부 페이지에 머문 시간이 매우 짧으면 복귀 안내 대상이 아닐 수 있습니다." } } } },
    "reservation_help_faq_return_question" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱으로 돌아왔는데 안내가 보이지 않나요?" } } } },
    "reservation_help_faq_sensitive_answer" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보가 포함될 수 있는 링크는 저장 전 경고합니다. 저장하면 이 기기에만 남고 백업 대상에서 제외됩니다." } } } },
    "reservation_help_faq_sensitive_question" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "민감한 링크라는 경고가 나오나요?" } } } },
    "reservation_help_groups_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "예매 완료·구매 완료·예약 완료 상태이고 일정이 남은 항목은 예정된 내역에 표시됩니다. 취소·환불·이용 완료 상태이거나 일정이 지난 항목은 지난 내역에 표시됩니다." } } } },
    "reservation_help_groups_point" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 내역에는 내역을 저장한 시각을 표시합니다." } } } },
    "reservation_help_groups_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "예정된 내역과 지난 내역" } } } },
    "reservation_help_link_priority_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "상세 링크가 있으면 그 링크를 먼저 사용합니다. 없으면 제공사 내역 URL, 최초 링크 순으로 열 수 있습니다." } } } },
    "reservation_help_link_priority_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "어떤 링크를 여나요?" } } } },
    "reservation_help_linkless_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "외부 페이지에서 상세 링크를 찾지 못했다면 링크 없이 추가를 선택하세요." } } } },
    "reservation_help_linkless_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "상세 링크가 없어도 추가할 수 있습니다" } } } },
    "reservation_help_list_summary" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "링크를 열 때 생기는 확인 필요 항목은 임시 기록입니다. 외부 서비스의 실제 완료 여부는 앱이 자동으로 확인하지 않습니다." } } } },
    "reservation_help_list_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 예약·구매 도움말" } } } },
    "reservation_help_official_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 행사 정보가 변경되거나 취소되어도 사용자의 내역 상태와 수정값은 자동으로 변경되지 않습니다." } } } },
    "reservation_help_official_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 정보는 내역을 자동 변경하지 않습니다" } } } },
    "reservation_help_overrides_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 수정한 제목·일정·장소가 저장 당시의 공식 정보보다 우선 표시됩니다." } } } },
    "reservation_help_overrides_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 수정한 정보가 우선입니다" } } } },
    "reservation_help_pending_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "링크를 열면 확인 필요 항목이 생기며 최대 2시간 동안 유지된 뒤 자동으로 정리됩니다. 앱은 외부 서비스의 실제 완료 여부를 자동 확인하지 않습니다." } } } },
    "reservation_help_pending_point" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 복귀 안내가 보이지 않아도 내 예약·구매의 확인 필요에서 직접 추가할 수 있습니다." } } } },
    "reservation_help_pending_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인 필요는 임시 항목입니다" } } } },
    "reservation_help_status_getting_started_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "아래 3단계에 따라 첫 내역을 추가해 보세요." } } } },
    "reservation_help_status_getting_started_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 사용하고 계신가요?" } } } },
    "reservation_help_status_manage_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장한 내역은 상태와 일정에 따라 예정된 내역 또는 지난 내역에서 관리할 수 있습니다." } } } },
    "reservation_help_status_manage_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 내역을 관리하세요" } } } },
    "reservation_help_status_pending_body_format" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인할 임시 항목이 %d개 있습니다. 가장 이른 항목은 %@ 예정입니다." } } } },
    "reservation_help_status_pending_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금 확인할 내역이 있습니다" } } } },
    "reservation_help_step_accessibility_format" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "%d단계, %@. %@" } } } },
    "reservation_help_step_add_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인 필요 항목을 내역에 추가합니다. 상세 링크를 찾지 못해도 링크 없이 추가할 수 있습니다." } } } },
    "reservation_help_step_add_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱으로 돌아와 내역 추가" } } } },
    "reservation_help_step_external_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "외부 서비스에서 예매·결제·예약을 진행합니다." } } } },
    "reservation_help_step_external_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "외부 페이지에서 진행" } } } },
    "reservation_help_step_open_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "티켓·구매·예약 링크를 엽니다." } } } },
    "reservation_help_step_open_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "굿즈·행사에서 링크 열기" } } } },
    "reservation_help_steps_header" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음이라면 이렇게 사용하세요" } } } },
    "reservation_help_storage_body" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "정식 내역은 서버로 전송되지 않고 이 기기에만 저장됩니다. 예약 데이터는 백업 대상에서 제외되어 앱 삭제나 기기 변경 시 복구되지 않을 수 있습니다." } } } },
    "reservation_help_storage_point" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "예매·주문·예약번호와 민감한 링크를 다른 사람과 공유하지 마세요." } } } },
    "reservation_help_storage_title" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "내역은 이 기기에만 저장됩니다" } } } },
    "reservation_help_tone_danger" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "중요 경고" } } } },
    "reservation_help_tone_info" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 방법" } } } },
    "reservation_help_tone_normal" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "안내" } } } },
