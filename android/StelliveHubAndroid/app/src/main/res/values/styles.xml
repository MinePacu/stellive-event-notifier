<resources>
    <style name="Theme.StelliveHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hub_primary</item>
        <item name="colorSecondary">@color/hub_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.StelliveHub.ReservationQuickAdd" parent="Theme.StelliveHub">
        <item name="android:statusBarColor">@color/hub_background</item>
        <item name="android:navigationBarColor">@color/hub_card</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="ThemeOverlay.StelliveHub.PopupMenu" parent="">
        <item name="popupMenuStyle">@style/Widget.StelliveHub.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.StelliveHub.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.StelliveHub.PopupMenu</item>
    </style>

    <style name="Widget.StelliveHub.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_hub_popup_menu</item>
    </style>

    <style name="TextAppearance.StelliveHub.PopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/hub_popup_menu_text</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
