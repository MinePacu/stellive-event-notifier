generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id                 String   @id
  platform           String
  deviceToken        String?
  tokenStatus        String   @default("active")
  locale             String?
  timezone           String?
  appVersion         String?
  realtimeEnabled    Boolean  @default(false)
  realtimeAcknowledged Boolean @default(false)
  lastSeenAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tokenStatus, id])
}

model NotificationPreference {
  id             String   @id @default(cuid(2))
  deviceId       String
  scope          String
  generationId   String?
  memberId       String?
  source         String?
  eventType      String?
  enabled        Boolean
  explicitOverride Boolean @default(false)
  tapAction      String   @default("open_app")
  deliveryMode   String   @default("standard")
  data           Json?
  updatedAt      DateTime @updatedAt
}

model PlatformEvent {
  id                  String   @id
  source              String
  type                String
  memberId            String
  generationId        String
  title               String
  body                String
  platformUrl         String?
  appDeepLink         String
  occurredAt          DateTime
  receivedAt          DateTime
  dedupeKey           String   @unique
  realtimeEligible    Boolean
  deliveryMode        String
  rawPayloadHash      String?
  sourceVerificationState String @default("verified")
  metadata            Json?
  ingestionLatencyMs  Int?
  deliveryRequestedAt DateTime?
}

model DeliveryAttempt {
  id                String   @id @default(cuid(2))
  eventId           String
  deviceId          String?
  attemptedAt       DateTime @default(now())
  deliveredAt       DateTime?
  status            String
  reason            String?
  tapActionUsed     String
  title             String
  body              String
  source            String
  eventType         String
  generationId      String
  memberId          String
  deliveryMode      String
  deliveryLevel     String?
  loadReductionReason String?
  pushPriority      String
  providerMessageId String?
  providerErrorCode String?
  deliveryLatencyMs Int?
  retryCount        Int      @default(0)
  expiresAt         DateTime?

  @@index([attemptedAt])
  @@index([status, attemptedAt])
}

model LiveStatus {
  memberId           String   @id
  generationId        String
  isLive              Boolean
  title               String?
  liveCategory        String?
  thumbnailUrl        String?
  viewerCount         Int?
  startedAt           DateTime?
  platformUrl         String?
  lastCheckedAt       DateTime
  realtimeObservedAt  DateTime?
  sourceVerificationState String @default("verified")
  lastTransitionAt    DateTime?
}

model PlatformApiState {
  id        String   @id @default(cuid(2))
  source    String
  key       String
  value     Json
  status    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([source, key])
  @@index([source, status])
}

model ChannelImageCache {
  id              String   @id @default(cuid(2))
  source          String   @default("youtube")
  channelId       String
  imageUrl        String?
  title           String?
  status          String   @default("missing")
  refreshedAt     DateTime?
  lastAttemptedAt DateTime?
  lastFailedAt    DateTime?
  nextRetryAt     DateTime?
  failureCount    Int      @default(0)
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, channelId])
  @@index([status, nextRetryAt])
  @@index([refreshedAt])
}

model ExternalApiCallLog {
  id           String   @id @default(cuid(2))
  source       String
  operation    String
  method       String
  host         String
  path         String
  statusCode   Int?
  resultStatus String
  durationMs   Int?
  quotaUnits   Int      @default(0)
  rateLimited  Boolean  @default(false)
  errorCode    String?
  errorReason  String?
  requestedAt  DateTime
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([requestedAt])
  @@index([source, requestedAt])
  @@index([operation, requestedAt])
  @@index([resultStatus, requestedAt])
}

model NotificationJob {
  id        String   @id @default(cuid(2))
  eventId   String
  priority  Int
  status    String
  runAfter  DateTime @default(now())
  lockedAt  DateTime?
  lockedBy  String?
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter, priority])
  @@index([eventId])
}

model WebhookSubscription {
  id             String   @id @default(cuid(2))
  source         String
  targetId       String
  callbackUrl    String
  topicUrl       String
  status         String
  leaseExpiresAt DateTime?
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, targetId, topicUrl])
  @@index([source, status])
}

model YoutubeChannelState {
  id                      String   @id @default(cuid(2))
  memberId                String
  channelId               String   @unique
  topicUrl                String?
  status                  String
  subscribedAt            DateTime?
  expiresAt               DateTime?
  lastRenewAttemptAt      DateTime?
  lastSuccessfulReceiptAt DateTime?
  etag                    String?
  newestVideoId           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([memberId])
  @@index([status, expiresAt])
}

model Song {
  id                       String   @id @default(cuid(2))
  youtubeVideoId           String
  youtubeChannelId         String
  dedupeKey                 String   @unique
  title                    String
  memberId                 String
  memberName               String
  generationId             String
  generationName           String
  songType                 String
  classificationConfidence Float?
  sourceUrl                String
  thumbnailUrl             String?
  thumbnailWidth           Int?
  thumbnailHeight          Int?
  duration                 String?
  privacyStatus            String?
  youtubePresentationType  String   @default("regular")
  youtubePremiereState     String?
  youtubeScheduledStartAt  DateTime?
  youtubeActualStartAt     DateTime?
  youtubeActualEndAt       DateTime?
  youtubeMetadataFetchedAt DateTime?
  listingPriority          Int      @default(2)
  publishedAt              DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([youtubeVideoId])
  @@index([youtubeChannelId])
  @@index([generationId])
  @@index([memberId])
  @@index([songType])
  @@index([publishedAt])
}

model SongClassificationOverride {
  id             String   @id @default(cuid(2))
  youtubeVideoId String   @unique
  songType       String
  reason         String
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

model MusicMember {
  id               String   @id
  nameKo           String
  nameEn           String
  aliases          Json
  generationOrGroup String?
  isGraduated      Boolean  @default(false)
  youtubeChannelId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  itemLinks        MusicItemMember[]

  @@index([youtubeChannelId])
}

model SourcePlaylist {
  id                   String   @id @default(cuid(2))
  youtubePlaylistId    String   @unique
  title                String
  type                 String
  rawCategoryHint      String
  memberId             String?
  isActive             Boolean  @default(true)
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncError        String?
  etag                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items                MusicItem[]
  itemSources          MusicItemSourcePlaylist[]

  @@index([type, isActive])
  @@index([memberId])
}

model MusicItem {
  id               String   @id @default(cuid(2))
  youtubeVideoId   String   @unique
  title            String
  normalizedTitle  String?
  description      String?
  type             String
  sourcePlaylistId String?
  publishedAt      DateTime?
  thumbnailUrl     String?
  thumbnailWidth   Int?
  thumbnailHeight  Int?
  duration         String?
  durationSeconds  Int?
  channelId        String?
  channelTitle     String?
  isPublic         Boolean  @default(true)
  privacyStatus    String?
  embeddable       Boolean?
  madeForKids      Boolean?
  dimension        String?
  definition       String?
  caption          String?
  tags             Json?
  isAvailable      Boolean  @default(true)
  isExcluded       Boolean  @default(false)
  exclusionReason  String?
  classificationStatus String @default("AUTO_CLASSIFIED")
  isInstrumental   Boolean  @default(false)
  specialFlags     Json?
  youtubePresentationType String   @default("regular")
  youtubePremiereState    String?
  youtubeScheduledStartAt DateTime?
  youtubeActualStartAt    DateTime?
  youtubeActualEndAt      DateTime?
  youtubeMetadataFetchedAt DateTime?
  listingPriority         Int      @default(2)
  fetchedAt        DateTime?
  lastSeenAt       DateTime
  missingCount     Int      @default(0)
  playlistPosition Int?
  rawCategoryHint  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourcePlaylist   SourcePlaylist? @relation(fields: [sourcePlaylistId], references: [id])
  members          MusicItemMember[]
  sourcePlaylists  MusicItemSourcePlaylist[]
  override         MusicItemOverride?

  @@index([type])
  @@index([publishedAt])
  @@index([sourcePlaylistId])
  @@index([isPublic])
  @@index([isAvailable, isExcluded])
  @@index([classificationStatus])
}

model MusicItemMember {
  musicItemId String
  memberId    String
  role        String   @default("unknown")
  confidence  Float    @default(0)
  source      String   @default("UNKNOWN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  musicItem   MusicItem   @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  member      MusicMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([musicItemId, memberId])
  @@index([memberId])
  @@index([role])
  @@index([source])
}

model MusicItemSourcePlaylist {
  id                     String         @id @default(cuid(2))
  musicItemId            String
  sourcePlaylistId       String
  youtubePlaylistItemId  String?
  sourcePlaylistTitle    String?
  sourcePlaylistPosition Int?
  sourcePlaylistType     String
  seenAt                 DateTime
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  musicItem              MusicItem      @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  sourcePlaylist         SourcePlaylist @relation(fields: [sourcePlaylistId], references: [id], onDelete: Cascade)

  @@unique([musicItemId, sourcePlaylistId])
  @@index([sourcePlaylistId])
  @@index([sourcePlaylistType])
}

model MusicItemOverride {
  id              String    @id @default(cuid(2))
  musicItemId     String    @unique
  youtubeVideoId  String    @unique
  forcedType      String?
  forcedMemberIds Json?
  forceExcluded   Boolean   @default(false)
  exclusionReason String?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  musicItem       MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
}

model MusicSyncRun {
  id               String   @id @default(cuid(2))
  syncType         String
  source           String
  sourcePlaylistId String?
  startedAt        DateTime
  finishedAt       DateTime?
  status           String   @default("running")
  quotaUnits       Int      @default(0)
  fetchedCount     Int      @default(0)
  insertedCount    Int      @default(0)
  updatedCount     Int      @default(0)
  missingCount     Int      @default(0)
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([syncType, startedAt])
  @@index([sourcePlaylistId, startedAt])
  @@index([status])
}

model HubEvent {
  id                    String   @id @default(cuid(2))
  category              String
  participationMode     String
  status                String
  scheduleMode          String   @default("single_window")
  title                 String
  summary               String?
  memberId              String?
  generationId          String
  sourceUrl             String
  sourceLabel           String
  sourceType            String
  announcedAt           DateTime?
  startsAt              DateTime?
  endsAt                DateTime?
  purchaseUrl           String?
  ticketUrl             String?
  venueName             String?
  venueAddress          String?
  image                 Json?
  notificationEligible  Boolean  @default(true)
  publicationState      String   @default("draft")
  publishedAt           DateTime?
  cancelledAt           DateTime?
  deactivatedAt         DateTime?
  deletedAt             DateTime?
  revision              Int      @default(1)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  scheduleItems         HubEventScheduleItem[]

  @@index([publicationState, deletedAt])
  @@index([status])
  @@index([category])
  @@index([participationMode])
  @@index([generationId])
  @@index([memberId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([updatedAt])
}

model HubEventScheduleItem {
  id                   String   @id @default(cuid(2))
  hubEventId           String
  kind                 String
  label                String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  timePrecision        String
  timezone             String   @default("Asia/Seoul")
  actionUrl            String?
  sourceUrl            String?
  sourceLabel          String?
  notificationEligible Boolean  @default(true)
  isPrimary            Boolean  @default(false)
  sortOrder            Int      @default(0)
  cancelledAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hubEvent HubEvent @relation(fields: [hubEventId], references: [id], onDelete: Cascade)

  @@index([hubEventId, sortOrder])
  @@index([hubEventId, startsAt])
  @@index([startsAt])
  @@index([cancelledAt])
}

model HubCalendarSpecialDayOccurrence {
  id              String   @id
  specialDayId    String
  kind            String
  displayYear     Int
  displayDate     String
  title           String
  specialDayLabel String
  generationId    String
  memberId        String?
  startsAt        DateTime
  endsAt          DateTime
  sourceLabel     String
  policyState     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([specialDayId, displayYear])
  @@index([displayDate])
  @@index([startsAt])
  @@index([endsAt])
  @@index([generationId])
  @@index([memberId])
  @@index([kind])
}

model HubEventAuditLog {
  id         String   @id @default(cuid(2))
  hubEventId String
  action     String
  actorId    String?
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([hubEventId, createdAt])
  @@index([action, createdAt])
}

model ServiceAnnouncement {
  id                 String   @id @default(cuid(2))
  type               String
  severity           String
  publicationState   String   @default("draft")
  title              String
  summary            String
  body               String
  isPinned           Boolean  @default(false)
  targetPlatforms    Json
  minimumAppVersion  String?
  maximumAppVersion  String?
  appDeepLink        String?
  externalUrl        String?
  actionLabel        String?
  publishedAt        DateTime?
  expiresAt          DateTime?
  resolvedAt         DateTime?
  archivedAt         DateTime?
  deletedAt          DateTime?
  pushEnabled        Boolean  @default(true)
  pushStatus         String   @default("not_requested")
  pushSentAt         DateTime?
  attentionRevision  Int      @default(1)
  revision           Int      @default(1)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pushAttempts ServiceAnnouncementPushAttempt[]

  @@index([publicationState, publishedAt])
  @@index([type, publicationState])
  @@index([severity, publicationState])
  @@index([expiresAt, publicationState])
  @@index([deletedAt, publicationState])
}

model ServiceAnnouncementPushAttempt {
  id                String   @id @default(cuid(2))
  announcementId    String
  attentionRevision Int
  topic             String
  status            String
  providerMessageId String?
  providerErrorCode String?
  retryAfterMs      Int?
  requestedBy       String?
  requestedAt       DateTime @default(now())
  completedAt       DateTime?

  announcement ServiceAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, requestedAt])
  @@index([status, requestedAt])
  @@index([announcementId, attentionRevision, status])
}

model ServiceAnnouncementAuditLog {
  id             String   @id @default(cuid(2))
  announcementId String
  action         String
  actorId        String?
  reason         String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([announcementId, createdAt])
  @@index([action, createdAt])
}
