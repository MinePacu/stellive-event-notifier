{
  "name": "stellive-hub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/stellive-hub-api/src/index.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "reload:pm2": "pm2 reload ecosystem.config.cjs --update-env",
    "start:chzzk-live-worker": "node dist/backend/stellive-hub-api/src/workers/chzzkLivePollWorker.js",
    "start:hub-event-status-worker": "node dist/backend/stellive-hub-api/src/workers/hubEventStatusReconcileWorker.js",
    "start:music-channel-discovery-worker": "node dist/backend/stellive-hub-api/src/workers/musicChannelDiscoveryWorker.js",
    "start:service-topic-cleanup": "node dist/backend/stellive-hub-api/src/workers/serviceTopicCleanupWorker.js",
    "dev:chzzk-live-worker": "tsx src/workers/chzzkLivePollWorker.ts",
    "dev:hub-event-status-worker": "tsx src/workers/hubEventStatusReconcileWorker.ts",
    "dev:music-channel-discovery-worker": "tsx src/workers/musicChannelDiscoveryWorker.ts",
    "start:service-topic-reconcile": "node dist/backend/stellive-hub-api/src/workers/serviceTopicReconcileWorker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:push:deploy": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "uuid": "14.0.0"
  }
}
